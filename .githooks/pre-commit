#!/bin/sh
# Block a commit that closes a ticket without recording what it opened up,
# or that leaves a placeholder nobody is on the hook for.
fail=0
python tools/check_wayfinder_ticket_hygiene.py || fail=1
python tools/check_no_orphan_placeholders.py || fail=1
if [ "$fail" -ne 0 ]; then
    echo ""
    echo "Commit refused. Fix what is listed above, or use --no-verify only if"
    echo "you have a reason you can write down."
    exit 1
fi
